# 이 파일을 .env로 복사해 값을 채운다. (.env는 git에 올리지 않는다)

# 로컬 개발용(선택). 앱은 file: 값이면 무시하고 <작업 폴더>/prisma/dev.db를 쓴다.
DATABASE_URL=

# 원격 libsql(libsql://, https://)을 쓸 때만 필요
DATABASE_AUTH_TOKEN=

# 웹 푸시(VAPID). `node scripts/gen-vapid.cjs` 로 생성한 값을 채운다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 푸시 발송 cron 이 /api/push/run 을 호출할 때 쓰는 비밀값 (x-cron-secret 헤더와 일치해야 함)
# 생성: openssl rand -hex 32
CRON_SECRET=
